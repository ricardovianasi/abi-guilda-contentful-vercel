# Contentful Configuration
# Get these values from your Contentful space settings
# Go to: Settings -> API keys

# Required: Your Contentful Space ID
CONTENTFUL_SPACE_ID=your_space_id_here

# Required: Content Delivery API Token (for published content)
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here

# Optional: Content Preview API Token (for draft/unpublished content)
CONTENTFUL_PREVIEW_TOKEN=your_preview_api_token_here

# Optional: Environment ID (default: master)
CONTENTFUL_ENV_ID=master

# Optional: Contentful API Host (default: cdn.contentful.com)
# The host determines which token is used:
#   - cdn.contentful.com → uses CONTENTFUL_ACCESS_TOKEN (published only)
#   - preview.contentful.com → uses CONTENTFUL_PREVIEW_TOKEN (published + drafts)
# CONTENTFUL_HOST=cdn.contentful.com

# Optional: Content Management API Token (for migrations, creating content via API)
CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_here







